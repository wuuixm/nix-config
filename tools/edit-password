import os
import re
import shutil
import sys
import tempfile
import subprocess

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
PROJECT_ROOT = os.path.abspath(os.path.join(SCRIPT_DIR, ".."))

SECRETS_ROOT = os.path.join(PROJECT_ROOT, "hm-modules", "agenix")
SECRETS_NIX = os.path.join(SECRETS_ROOT, "secrets.nix")
SECRETS_DIR = os.path.join(SECRETS_ROOT, "keys")

class SecretsManager:
    def __init__(self):
        self.ensure_env()
        self.snapshot_dir = tempfile.mkdtemp(prefix="secrets_bak_")
        self.make_snapshot(self.snapshot_dir)

        self.keys = {}
        self.secrets = {}
        self.load_from_nix()

    def ensure_env(self):
        if not os.path.exists(SECRETS_NIX):
            print(f"错误: 未能在 {SECRETS_NIX} 找到 secrets.nix！")
            sys.exit(1)
        os.makedirs(SECRETS_DIR, exist_ok=True)

    def make_snapshot(self, target_dir):
        shutil.copy2(SECRETS_NIX, os.path.join(target_dir, "secrets.nix"))
        target_keys_dir = os.path.join(target_dir, "keys")
        if os.path.exists(target_keys_dir):
            shutil.rmtree(target_keys_dir)
        if os.path.exists(SECRETS_DIR):
            shutil.copytree(SECRETS_DIR, target_keys_dir)

    def restore_snapshot(self):
        shutil.copy2(os.path.join(self.snapshot_dir, "secrets.nix"), SECRETS_NIX)
        if os.path.exists(SECRETS_DIR):
            shutil.rmtree(SECRETS_DIR)
        bak_keys = os.path.join(self.snapshot_dir, "keys")
        if os.path.exists(bak_keys):
            shutil.copytree(bak_keys, SECRETS_DIR)
        self.load_from_nix()
        print("成功: 已恢复到本次运行前的初始状态！")

    def load_from_nix(self):
        self.keys.clear()
        self.secrets.clear()
        with open(SECRETS_NIX, "r", encoding="utf-8") as f:
            content = f.read()

        key_matches = re.findall(r'(?<![\w.])([a-zA-Z0-9_]+Key[s]?)\s*=\s*(.*?);', content, re.DOTALL)
        for k_name, k_val in key_matches:
            self.keys[k_name.strip()] = k_val.strip()

        secret_matches = re.findall(r'"([^"]+\.age)"\.publicKeys\s*=\s*\[\s*([a-zA-Z0-9_]+)\s*\];', content)
        for s_path, s_key in secret_matches:
            self.secrets[s_path] = s_key.strip()

    def save_to_nix(self):
        lines = ["let"]
        for k, v in self.keys.items():
            lines.append(f"  {k} = {v};")
        lines.append("in")
        lines.append("{")
        for s_path, s_key in self.secrets.items():
            lines.append(f'  "{s_path}".publicKeys = [ {s_key} ];')
        lines.append("}")

        with open(SECRETS_NIX, "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")

    def is_key_exists(self, key_name):
        return key_name in self.keys

    def is_secret_exists(self, secret_name):
        rel_path = f"keys/{secret_name}.age"
        return rel_path in self.secrets

    def decrypt_secret_to_text(self, secret_name):
        rel_path = f"keys/{secret_name}.age"
        try:
            cmd = f"cd '{SECRETS_ROOT}' && agenix -d '{rel_path}' 2>/dev/null"
            res = subprocess.run(cmd, shell=True, capture_output=True, text=True)
            if res.returncode != 0:
                print(f"警告: 解密 {secret_name} 失败，请检查身份密钥是否可用")
            return res.stdout if res.returncode == 0 else ""
        except Exception:
            print(f"警告: 解密 {secret_name} 时发生异常")
            return ""

    def create_or_update_age_file(self, secret_name, plaintext):
        rel_path = f"keys/{secret_name}.age"
        with tempfile.NamedTemporaryFile("w+", delete=False) as tf:
            tf.write(plaintext)
            temp_path = tf.name

        try:
            self.save_to_nix()
            subprocess.run(f"cat '{temp_path}' | (cd '{SECRETS_ROOT}' && agenix -e '{rel_path}' >/dev/null 2>&1)", shell=True)
        finally:
            if os.path.exists(temp_path):
                os.remove(temp_path)

    def add_key(self):
        print("\n--- 添加公钥 ---")
        name = input("请输入公钥变量名称 (必须以 Key): ").strip()
        if not (name.endswith("Key") or name.endswith("Keys")):
            print("错误: 公钥变量名必须以 'Key' 或 'Keys' 结尾！")
            return
        if self.is_key_exists(name):
            print(f"错误: 公钥名称 {name} 已存在！")
            return

        content = input("请输入公钥内容: ").strip()
        if not content:
            print("错误: 公钥内容不能为空！")
            return

        self.keys[name] = content
        self.save_to_nix()
        print(f"成功: 已添加公钥 {name}")

    def edit_key(self):
        print("\n--- 编辑公钥 ---")
        key_list = list(self.keys.keys())
        if not key_list:
            print("提示: 当前没有可编辑的公钥。")
            return

        for idx, k in enumerate(key_list):
            print(f"  [{idx + 1}] {k}")

        choice = input(f"请选择要编辑的公钥 [1-{len(key_list)}]: ").strip()
        if not choice.isdigit() or not (1 <= int(choice) <= len(key_list)):
            print("错误: 无效选择")
            return

        old_name = key_list[int(choice) - 1]
        print(f"当前编辑: {old_name}")

        new_name = input(f"请输入新名称 (留空保持 '{old_name}'): ").strip()
        if new_name:
            if not (new_name.endswith("Key") or new_name.endswith("Keys")):
                print("错误: 公钥变量名必须以 'Key' 或 'Keys' 结尾！")
                return
            if new_name != old_name and self.is_key_exists(new_name):
                print(f"错误: 名称 {new_name} 已存在！")
                return
        else:
            new_name = old_name

        new_content = input("请输入新公钥内容 (留空保持原内容): ").strip()
        if not new_content:
            new_content = self.keys[old_name]

        if new_name != old_name:
            del self.keys[old_name]
            self.keys[new_name] = new_content
            for s_path, s_key in list(self.secrets.items()):
                if s_key == old_name:
                    self.secrets[s_path] = new_name
            print(f"提示: 已将引用了 {old_name} 的密码加密组联动更新为 {new_name}")
        else:
            self.keys[old_name] = new_content

        self.save_to_nix()
        subprocess.run(f"cd '{SECRETS_ROOT}' && agenix -r >/dev/null 2>&1", shell=True)
        print("成功: 公钥修改完成并已更新加密状态！")

    def delete_key(self):
        print("\n--- 删除公钥 ---")
        key_list = list(self.keys.keys())
        if not key_list:
            print("提示: 没有可删除的公钥。")
            return

        for idx, k in enumerate(key_list):
            print(f"  [{idx + 1}] {k}")

        choice = input(f"请选择要删除的公钥 [1-{len(key_list)}]: ").strip()
        if not choice.isdigit() or not (1 <= int(choice) <= len(key_list)):
            print("错误: 无效选择")
            return

        target_key = key_list[int(choice) - 1]
        affected_secrets = [s_path for s_path, s_key in self.secrets.items() if s_key == target_key]

        print(f"\n警告: 即将删除公钥 [{target_key}]")
        if affected_secrets:
            print("以下密码依赖于此公钥，删除公钥将同时删除这些密码及其物理文件:")
            for sec in affected_secrets:
                print(f"  - {sec}")
        else:
            print("当前无独立依赖此公钥的密码。")

        confirm = input("\n二次确认: 请输入 'yes' 确定删除: ").strip()
        if confirm.lower() != "yes":
            print("取消删除。")
            return

        del self.keys[target_key]
        for sec in affected_secrets:
            del self.secrets[sec]
            abs_f = os.path.join(SECRETS_DIR, os.path.basename(sec))
            if os.path.exists(abs_f):
                os.remove(abs_f)

        self.save_to_nix()
        print(f"成功: 已删除公钥 {target_key} 及相关的密码项。")

    def add_secret(self):
        print("\n--- 添加密码 ---")
        name = input("请输入密码名称 (例如 github-token): ").strip().replace(".age", "")
        if not name:
            print("错误: 名称不能为空！")
            return
        if self.is_secret_exists(name):
            print(f"错误: 密码 {name} 已存在！")
            return

        key_list = list(self.keys.keys())
        print("请选择用于加密该密码的公钥组:")
        for idx, k in enumerate(key_list):
            print(f"  [{idx + 1}] {k}")

        k_choice = input(f"选择 [1-{len(key_list)}]: ").strip()
        if not k_choice.isdigit() or not (1 <= int(k_choice) <= len(key_list)):
            print("错误: 无效选择")
            return
        selected_key = key_list[int(k_choice) - 1]

        plaintext = input("请输入明文密码内容: ").strip()

        rel_path = f"keys/{name}.age"
        self.secrets[rel_path] = selected_key
        self.create_or_update_age_file(name, plaintext)
        print(f"成功: 已添加密码 {name}")

    def edit_secret(self):
        print("\n--- 编辑密码 ---")
        secret_list = [s_path.replace("keys/", "").replace(".age", "") for s_path in self.secrets.keys()]
        if not secret_list:
            print("提示: 当前没有可编辑的密码。")
            return

        for idx, s in enumerate(secret_list):
            print(f"  [{idx + 1}] {s}")

        choice = input(f"选择要编辑的密码 [1-{len(secret_list)}]: ").strip()
        if not choice.isdigit() or not (1 <= int(choice) <= len(secret_list)):
            print("错误: 无效选择")
            return

        old_name = secret_list[int(choice) - 1]
        old_rel_path = f"keys/{old_name}.age"
        old_key = self.secrets[old_rel_path]
        old_plaintext = self.decrypt_secret_to_text(old_name)

        print(f"\n正在编辑密码 [{old_name}]")
        new_name = input(f"请输入新密码名称 (留空保持 '{old_name}'): ").strip().replace(".age", "")
        if not new_name:
            new_name = old_name
        elif new_name != old_name and self.is_secret_exists(new_name):
            print(f"错误: 密码名称 {new_name} 已存在！")
            return

        key_list = list(self.keys.keys())
        print(f"当前加密组为: {old_key}。请选择新公钥组 (直接回车保持不变):")
        for idx, k in enumerate(key_list):
            print(f"  [{idx + 1}] {k}")

        k_choice = input(f"选择 [1-{len(key_list)}]: ").strip()
        if k_choice.isdigit() and (1 <= int(k_choice) <= len(key_list)):
            new_key = key_list[int(k_choice) - 1]
        else:
            new_key = old_key

        new_plaintext = input("请输入新明文密码 (直接回车保持旧密码内容): ").strip()
        if not new_plaintext:
            new_plaintext = old_plaintext

        new_rel_path = f"keys/{new_name}.age"
        self.secrets[new_rel_path] = new_key
        self.create_or_update_age_file(new_name, new_plaintext)

        if old_rel_path != new_rel_path:
            del self.secrets[old_rel_path]
            old_abs_f = os.path.join(SECRETS_DIR, f"{old_name}.age")
            if os.path.exists(old_abs_f):
                os.remove(old_abs_f)
        else:
            del self.secrets[old_rel_path]

        self.save_to_nix()
        print(f"成功: 密码 [{old_name}] 已更新为 [{new_name}]！")

    def delete_secret(self):
        print("\n--- 删除密码 ---")
        secret_list = [s_path.replace("keys/", "").replace(".age", "") for s_path in self.secrets.keys()]
        if not secret_list:
            print("提示: 当前没有可编辑的密码。")
            return

        for idx, s in enumerate(secret_list):
            print(f"  [{idx + 1}] {s}")

        choice = input(f"选择要删除的密码 [1-{len(secret_list)}]: ").strip()
        if not choice.isdigit() or not (1 <= int(choice) <= len(secret_list)):
            print("错误: 无效选择")
            return

        target_name = secret_list[int(choice) - 1]
        rel_path = f"keys/{target_name}.age"

        confirm = input(f"二次确认: 请输入 'yes' 确定删除密码 [{target_name}]: ").strip()
        if confirm.lower() != "yes":
            print("取消删除。")
            return

        del self.secrets[rel_path]
        abs_f = os.path.join(SECRETS_DIR, f"{target_name}.age")
        if os.path.exists(abs_f):
            os.remove(abs_f)

        self.save_to_nix()
        print(f"成功: 已彻底删除密码 [{target_name}]。")

    def reset_all(self):
        print("\n--- 重置回初始状态 ---")
        confirm = input("二次确认: 是否放弃本次运行的所有修改，恢复到脚本启动前的状态？(输入 'yes' 确定): ").strip()
        if confirm.lower() == "yes":
            self.restore_snapshot()

    def clean_temp(self):
        if os.path.exists(self.snapshot_dir):
            shutil.rmtree(self.snapshot_dir)

def main():
    manager = SecretsManager()
    try:
        while True:
            print("\n==============================")
            print(" NixOS Secrets 统一管理工具 ")
            print("==============================")
            print("1. 添加公钥")
            print("2. 编辑公钥")
            print("3. 删除公钥")
            print("4. 添加密码")
            print("5. 编辑密码")
            print("6. 删除密码")
            print("7. 放弃本次修改并重置")
            print("8. 退出")
            print("")
            choice = input("请选择操作 [1-8]: ").strip()

            if choice == "1":
                manager.add_key()
            elif choice == "2":
                manager.edit_key()
            elif choice == "3":
                manager.delete_key()
            elif choice == "4":
                manager.add_secret()
            elif choice == "5":
                manager.edit_secret()
            elif choice == "6":
                manager.delete_secret()
            elif choice == "7":
                manager.reset_all()
            elif choice == "8":
                break
            else:
                print("错误: 无效输入，请重新选择")
    finally:
        manager.clean_temp()

if __name__ == "__main__":
    main()
